{
  "name": "@aizign/adapter-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "Aizign harness adapter for DSH: a scope-bound submit_workflow_signal tool backed by the aizign binary over Protocol v1",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TakahisaI/Aizign.git",
    "directory": "adapters/dsh"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./experimental/transport": {
      "types": "./lib/experimental/transport.d.ts",
      "default": "./lib/experimental/transport.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "dsh": "0.1.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "contributes": {
      "tools": [
        "submit_workflow_signal"
      ],
      "skills": []
    }
  },
  "dependencies": {
    "@aizign/protocol": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@aizign/adapter-testkit": "0.1.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "pack:check": "npm pack --dry-run --json > /dev/null"
  }
}
