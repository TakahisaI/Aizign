{
  "name": "aizu-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "npm workspace root for Aizu TypeScript packages and harness adapters (not published)",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TakahisaI/Aizu.git"
  },
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "packageManager": "npm@11.19.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.7.0 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "check": "echo \"no TypeScript packages yet; checks are added with the first package\" && exit 0"
  }
}
