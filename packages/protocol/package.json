{
  "name": "@aizign/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Aizign Protocol v1 for TypeScript: pure wire codec, compatibility, correlation, and core-client contract",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TakahisaI/Aizign.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "pack:check": "npm pack --dry-run --json > /dev/null"
  }
}
