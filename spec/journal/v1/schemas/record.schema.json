{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aizu.dev/spec/journal/v1/record.schema.json",
  "title": "Aizu journal record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "seq", "at", "kind", "signal"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "integer", "minimum": 1577836800, "maximum": 4102444800 },
    "kind": { "type": "string", "enum": ["workflow.signal.accepted"] },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "workflowId", "assignmentId", "role", "artifactRevision", "kind"],
      "properties": {
        "eventId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "workflowId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "assignmentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "role": { "type": "string", "enum": ["implementation", "review"] },
        "artifactRevision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "kind": {
          "type": "string",
          "enum": ["implementation_ready", "review_findings", "review_passed", "repair_submitted", "blocked"]
        },
        "findingCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "artifactRef": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
        "shortErrorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
      }
    }
  }
}
