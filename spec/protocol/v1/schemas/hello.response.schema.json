{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aizign.dev/spec/protocol/v1/hello.response.schema.json",
  "title": "hello response payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "journalSchemaVersion",
    "capabilities",
    "package"
  ],
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "journalSchemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "description": "Request kinds beyond `hello`. Open for future versions; v1 defines exactly `workflow.signal.submit`. Compatibility is decided by checkCompatibility, not by decoding.",
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
