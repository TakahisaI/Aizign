{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aizign.dev/spec/protocol/v1/workflow-signal-reconcile.response.schema.json",
  "title": "workflow.signal.reconcile success payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["disposition", "eventId"],
  "properties": {
    "disposition": { "type": "string", "enum": ["accepted", "conflict", "absent"] },
    "eventId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  }
}
