{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aizign.dev/spec/protocol/v1/workflow-signal-submit.request.schema.json",
  "title": "workflow.signal.submit request payload",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hex"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "role": {
      "type": "string",
      "enum": ["implementation", "review"]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["expected", "signal"],
  "properties": {
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowId",
        "assignmentId",
        "attemptId",
        "role",
        "artifactRevision",
        "candidateDigest"
      ],
      "properties": {
        "workflowId": { "$ref": "#/$defs/identifier" },
        "assignmentId": { "$ref": "#/$defs/identifier" },
        "attemptId": { "$ref": "#/$defs/identifier" },
        "role": { "$ref": "#/$defs/role" },
        "artifactRevision": { "$ref": "#/$defs/identifier" },
        "candidateDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "signal": { "$ref": "workflow-signal.schema.json" }
  }
}
